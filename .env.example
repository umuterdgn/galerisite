# ==============================================================================
# LUMIÈRE LUXURY REAL ESTATE SAAS - PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Bu dosya, canlıya (Production - Vercel / DigitalOcean / AWS) alma sürecinde
# sisteme tanımlanması gereken tüm çevre değişkenlerinin şablonudur.
# Canlı ortamda bu değerleri Vercel Dashboard > Project Settings > Environment Variables
# veya sunucunuzdaki .env dosyasına kopyalayarak gerçek anahtarlarınızla doldurunuz.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL VERİTABANI & PGVECTOR YAPILANDIRMASI (DigitalOcean / Supabase / Neon)
# ------------------------------------------------------------------------------
# Canlı PostgreSQL veritabanı bağlantı adresi.
# NOT: Veritabanında 'vector' (pgvector) eklentisinin aktif olması gerekir.
# 'CREATE EXTENSION IF NOT EXISTS "vector";'
DATABASE_URL="postgresql://doadmin:YOUR_DB_PASSWORD@your-db-instance.ondigitalocean.com:25060/galerisite_db?sslmode=require"

# PgBouncer veya connection pooler kullanılıyorsa, doğrudan bağlantı adresi (Prisma migrate için):
DIRECT_URL="postgresql://doadmin:YOUR_DB_PASSWORD@your-db-instance.ondigitalocean.com:25060/galerisite_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH.JS & GÜVENLİK (JWT Tabanlı Kimlik Doğrulama)
# ------------------------------------------------------------------------------
# JWT oturumlarını şifrelemek için kullanılan 256-bit gizli anahtar.
# Terminalden 'openssl rand -base64 32' çalıştırarak rastgele güvenli anahtar üretebilirsiniz.
NEXTAUTH_SECRET="your-super-secret-random-32-byte-hex-or-base64-key"

# Canlı uygulamanızın ana domain adresi:
NEXTAUTH_URL="https://your-domain.vercel.app"

# Uygulama genelinde kullanılan public kök URL:
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDYA & CDN (Görseller, 360 Panoramalar, Drone Videoları)
# ------------------------------------------------------------------------------
# Cloudinary Dashboard üzerinden alınan kimlik bilgileri:
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_key"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="galerisite_luxury_preset"

# Sunucu taraflı Node.js SDK bağlantı URI'si:
CLOUDINARY_URL="cloudinary://123456789012345:your_cloudinary_api_secret_key@your_cloudinary_cloud_name"

# ------------------------------------------------------------------------------
# 4. MAPBOX HARİTA ENTEGRASYONU (GEO Keşif & İnteraktif Konum Pini)
# ------------------------------------------------------------------------------
# Mapbox account panelinden (account.mapbox.com) alınan Public Access Token:
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbHh4eHh4eHh4eHh4In0.example_access_token"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI API (Yapay Zekâ SEO, GEO ve Pazarlama Tavsiyeleri)
# ------------------------------------------------------------------------------
# Google AI Studio (aistudio.google.com) üzerinden alınan Gemini API anahtarı:
# AI SEO Generator, 150-160k Meta Açıklama, Schema.org ve Marketing Insights için kullanılır.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere1234567890"

# (Opsiyonel) OpenAI API Key - pgvector 1536-boyutlu embedding için harici alternatif
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. DİL & SİSTEM YAPILANDIRMASI
# ------------------------------------------------------------------------------
NODE_ENV="production"
